# Local Postgres (matches docker-compose.yml)
PAYLOAD_DATABASE_URL=postgresql://joselo:joselo@127.0.0.1:54339/joselo_blog

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=
PAYLOAD_PREVIEW_SECRET=

# Admin creation is off unless this flag is exactly true.
PAYLOAD_SEED_ADMIN=false
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Required in production for Payload Media. Leave empty locally to use public/media.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
