# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://joselo:joselo@127.0.0.1:54339/joselo_blog

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=
PAYLOAD_PREVIEW_SECRET=

# Optional: creates the first administrator when `npm run seed` runs.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Required in production for Payload Media. Leave empty locally to use public/media.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
