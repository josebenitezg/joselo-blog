{
  "name": "joselo-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "payload": "dotenv -e .env.local -- payload",
    "payload:generate": "dotenv -e .env.local -- payload generate:types && dotenv -e .env.local -- payload generate:importmap",
    "db:migrate": "dotenv -e .env.local -- payload migrate",
    "db:migrate:create": "dotenv -e .env.local -- payload migrate:create",
    "seed": "dotenv -e .env.local -- payload run src/seed/index.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "graphql": "16.11.0",
    "katex": "0.16.22",
    "next": "16.3.2",
    "payload": "3.88.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "dotenv-cli": "11.0.0",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.2",
    "tsx": "4.23.12",
    "typescript": "5.9.2"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
